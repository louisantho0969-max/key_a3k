    panel.BorderSizePixel = 0
    panel.Parent = loading

    Instance.new("UICorner", panel).CornerRadius =
        UDim.new(0, 14)

    local stroke = Instance.new("UIStroke", panel)
    stroke.Color = Color3.fromRGB(181, 212, 244)
    stroke.Thickness = 1.5

    -- Spinner
    local spinner = Instance.new("Frame")
    spinner.Size = UDim2.fromOffset(120, 120)
    spinner.AnchorPoint = Vector2.new(0.5, 0)
    spinner.Position = UDim2.new(0.5, 0, 0, 24)
    spinner.BackgroundTransparency = 1
    spinner.Parent = panel

    local ring = Instance.new("Frame")
    ring.Size = UDim2.fromOffset(112, 112)
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.fromScale(0.5, 0.5)
    ring.BackgroundTransparency = 1
    ring.Parent = spinner

    Instance.new("UICorner", ring).CornerRadius =
        UDim.new(1, 0)

    local ringStroke = Instance.new("UIStroke", ring)
    ringStroke.Color = Color3.fromRGB(181, 212, 244)
    ringStroke.Thickness = 2
    ringStroke.Transparency = 0.5

    local dots = {
        {18, Color3.fromRGB(24,95,165), 0},
        {16, Color3.fromRGB(55,138,221), 0},
        {14, Color3.fromRGB(55,138,221), 0.2},
        {12, Color3.fromRGB(133,183,235), 0.3},
        {10, Color3.fromRGB(133,183,235), 0.5},
        {8, Color3.fromRGB(181,212,244), 0.6},
    }

    for i, d in ipairs(dots) do
        local a = math.rad((i - 1) * 60)
        local dot = Instance.new("Frame")
        dot.Size = UDim2.fromOffset(d[1], d[1])
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.Position = UDim2.new(
            0.5, math.sin(a) * 56,
            0.5, -math.cos(a) * 56
        )
        dot.BackgroundColor3 = d[2]
        dot.BackgroundTransparency = d[3]
        dot.BorderSizePixel = 0
        dot.Parent = spinner
        Instance.new("UICorner", dot).CornerRadius =
            UDim.new(1, 0)
    end

    local center = Instance.new("Frame")
    center.Size = UDim2.fromOffset(44, 44)
    center.AnchorPoint = Vector2.new(0.5, 0.5)
    center.Position = UDim2.fromScale(0.5, 0.5)
    center.BackgroundColor3 = Color3.fromRGB(24, 95, 165)
    center.BorderSizePixel = 0
    center.Parent = spinner
    Instance.new("UICorner", center).CornerRadius =
        UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 24)
    label.Position = UDim2.new(0, 0, 0, 160)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 16
    label.TextColor3 = Color3.fromRGB(30, 41, 59)
    label.Text = "Chargement en cours"
    label.Parent = panel

    local track = Instance.new("Frame")
    track.Size = UDim2.fromOffset(240, 10)
    track.AnchorPoint = Vector2.new(0.5, 0)
    track.Position = UDim2.new(0.5, 0, 0, 200)
    track.BackgroundColor3 = Color3.fromRGB(181, 212, 244)
    track.BackgroundTransparency = 0.5
    track.BorderSizePixel = 0
    track.Parent = panel
    Instance.new("UICorner", track).CornerRadius =
        UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = Color3.fromRGB(24, 95, 165)
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius =
        UDim.new(1, 0)

    local tag = Instance.new("TextLabel")
    tag.Size = UDim2.new(1, 0, 0, 24)
    tag.Position = UDim2.new(0, 0, 0, 224)
    tag.BackgroundTransparency = 1
    tag.Font = Enum.Font.GothamBold
    tag.TextSize = 16
    tag.TextColor3 = Color3.fromRGB(24, 95, 165)
    tag.Text = "A3K"
    tag.Parent = panel

    -- Animations
    local running = true

    local conn = RunService.RenderStepped:Connect(function(dt)
        if not running then return end
        spinner.Rotation =
            (spinner.Rotation + dt * 225) % 360
    end)

    task.spawn(function()
        local startTime = os.clock()
        local n = 0

        local tween = TweenService:Create(
            fill,
            TweenInfo.new(15, Enum.EasingStyle.Linear),
            {Size = UDim2.fromScale(1, 1)}
        )
        tween:Play()

        while os.clock() - startTime < 15
            and loading.Parent do
            n = (n % 3) + 1
            label.Text = "Chargement en cours"
                .. string.rep(".", n)
            task.wait(0.7)
        end

        running = false
        conn:Disconnect()

        if loading.Parent then
            loading:Destroy()
        end

        -- Lancement du script après le chargement
        loadstring(game:HttpGet("https://raw.githubusercontent.com/louisantho0969-max/Kitk4t/refs/heads/main/Kitk4tt"))()
    end)
end

-- VALIDATION
local busy = false

submit.Activated:Connect(function()
    if busy then return end

    local enteredKey = input.Text:match("^%s*(.-)%s*$")

    if enteredKey == VALID_KEY then
        busy = true
        status.Text = "Key accepted!"
        submit.Active = false
        getKey.Active = false

        task.wait(0.3)
        gui:Destroy()
        showLoading()
    else
        status.Text = "Invalid key!"
        status.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)
